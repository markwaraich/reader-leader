{
  "name": "reader-leader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=production pnpm start",
    "build": "next build && node scripts/package-standalone.mjs",
    "build:verify": "NODE_ENV=production NEXT_DIST_DIR=.next-browser next build",
    "start": "HOSTNAME=0.0.0.0 PORT=3000 node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck",
    "test": "pnpm verify:core && pnpm verify:browser",
    "verify:core": "node --experimental-strip-types scripts/verify-core.ts",
    "verify:browser": "pnpm build:verify && node scripts/verify-browser.mjs",
    "format": "prettier --write .",
    "db:push": "drizzle-kit generate && drizzle-kit migrate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.693.0",
    "@aws-sdk/s3-request-presigner": "^3.693.0",
    "clsx": "2.1.1",
    "lucide-react": "1.39.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.4",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.4.1"
}
